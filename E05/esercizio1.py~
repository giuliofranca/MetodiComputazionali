import numpy as np
import matplotlib.pyplot as plt
from scipy import integrate
import argparse
import pandas as pd

# leggo il file
dati = pd.read_csv('vel_vs_time.csv')
plt.plot(dati['t'], dati['v'], label='velocita in funzione del tempo')
plt.xlabel('tempo (s)')
plt.ylabel('velocita (m/s)')
plt.legend()
plt.show()

# calcolo integrale definito della distanza totale
distanza_totale = integrate.simpson(dati['v'], dx = 0.5)
print('La distanza totale è ', distanza_totale,' metri')

#distanza in funzione del tempo
distanze = []
for i in range(len(dati['t'])):
               distanza_cumulativa = integrate.simpson(y = dati['v'][:i+1], x = dati['t'][:i+1])
               distanze.append(distanza_cumulativa)

array_distanze = np.array(distanze)

#grafico della distanza in funzione del tempo
plt.plot(dati['t'], array_distanze, label='distanza in funzione del tempo')
plt.xlabel('tempo (s)')
plt.ylabel('distanza(m)')
plt.legend()
plt.grid('True')
plt.show()

# modulo argparse per eseguire comandi da terminale
